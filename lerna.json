{
  "packages": [
    "packages/ui/*",
    "packages/ui-icons/*",
    "packages/ui-theme/*"
  ],
  "version": "4.0.0-beta.1",
  "npmClient": "pnpm",
  "useWorkspaces": true,
  "command": {
    "version": {
      "allowBranch": [
        "hot-fix",
        "v3-less",
        "v5-beta"
      ],
      "ignoreChanges": [
        "**/*.md",
        "**/stories/**",
        "**/__tests__/**",
        "**/.eslintrc.js",
        "**/jest.config.js",
        "**/tsconfig.json"
      ]
    },
    "publish": {
      "ignoreChanges": [
        "*.md"
      ],
      "verifyAccess": false,
      "verifyRegistry": false
    }
  }
}
